<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnVoltar"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voltar"
            android:textAllCaps="false"
            android:textColor="@color/primary_blue"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary_blue" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/configuracoes"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMudarTamanhoFonte"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/mudar_tamanho_fontes"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_color" />

                <Button
                    android:id="@+id/btnMudarTema"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/mudar_tema"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_color" />

                <Button
                    android:id="@+id/btnVerInfoUsuario"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/ver_informacoes_usuario"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/border_color" />

                <Button
                    android:id="@+id/btnSairPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="#FFF1F2"
                    android:text="@string/sair_do_perfil"
                    android:textAllCaps="false"
                    android:textColor="#E11D48"
                    app:cornerRadius="12dp"
                    app:strokeColor="#FDA4AF"
                    app:strokeWidth="1dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
